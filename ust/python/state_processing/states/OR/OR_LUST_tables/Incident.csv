33592,26-07-1574,26,07,1574,,2007-10-15,2007-10-15 15:14:44.660,"Barbee, Jerry",4105 SE 72nd Avenue,PORTLAND,97206,503-000-0000,False,5.0,,1.0,,False,True,False,,False,False,False,False,False,"E80 = 57 ppm
