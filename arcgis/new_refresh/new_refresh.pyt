# -*- coding: utf-8 -*-import arcpy,os,sys,json;from arcgis.gis import GIS;from arcgis.features import FeatureLayerCollection,FeatureLayer;##############################################################################g_prj  = "CURRENT";g_srid = 3857;# default zoom is set to Washington, DCg_default_zoom = arcpy.Extent(    XMin = -78.21   ,YMin =  38.11   ,XMax = -75.65   ,YMax =  39.28   ,spatial_reference = arcpy.SpatialReference(4326)).projectAs(arcpy.SpatialReference(g_srid));with open(    os.path.join(os.path.dirname(os.path.realpath(__file__)),'ust.json')   ,'r') as f:   g_config = json.load(f);   ###############################################################################def datasource(p_name,aprx = None):   if aprx is None:      aprx = arcpy.mp.ArcGISProject(g_prj);      if p_name not in g_config['schemas']:      raise Exception(str(p_name) + " schema not found");         if "geodatabase" not in g_config['schemas'][p_name]:      raise Exception("geodatabase missing from schema");         if "datasource" not in g_config['schemas'][p_name]:      raise Exception("geodatabase missing from schema");         if g_config['schemas'][p_name]['geodatabase'] == "default":      gd = aprx.defaultGeodatabase;   else:      gd = g_config['schemas'][p_name]['geodatabase'];         df = g_config['schemas'][p_name]['datasource'];      return os.path.join(gd,df);   ###############################################################################def fld_def(p_name):   if p_name not in g_config['schemas']:      raise Exception(str(p_name) + " not found");         if "flds" not in g_config['schemas'][p_name]:      raise Exception("error in schema");         results = [];   for item in g_config['schemas'][p_name]["flds"]:            results.append(item[:6]);      return results;   ###############################################################################def fld_idx(p_name):   if p_name not in g_config['schemas']:      raise Exception(str(p_name) + " not found");         if "flds" not in g_config['schemas'][p_name]:      raise Exception("error in schema");         results = [];   for item in g_config['schemas'][p_name]["flds"]:         if item[6]:         results.append(item[0]);            return results;###############################################################################class Toolbox(object):   def __init__(self):      self.label = "UST Refresh";      self.alias = "UST Refresh";      self.tools = [];      self.tools.append(RebuildSystemUST);      self.tools.append(ReloadFromAGOUST);      self.tools.append(LoadTribalCSVsAGO);      self.tools.append(RebuildMapsUST);      ###############################################################################class RebuildSystemUST(object):   #...........................................................................   def __init__(self):      self.label              = "A1 Rebuild System";      self.name               = "RebuildSystemUST";      self.description        = "RebuildSystemUST";      self.canRunInBackground = False;   #...........................................................................   def getParameterInfo(self):            params = [];            return params;   #...........................................................................   def isLicensed(self):      return True;   #...........................................................................   def updateParameters(self,parameters):      return;   #...........................................................................   def updateMessages(self,parameters):      return;   #...........................................................................   def execute(self,parameters,messages):      aprx = arcpy.mp.ArcGISProject(g_prj);      arcpy.env.workspace = aprx.defaultGeodatabase;            #########################################################################      if not arcpy.Exists(aprx.defaultGeodatabase):         arcpy.management.CreateMobileGDB(             out_folder_path = os.path.dirname(aprx.defaultGeodatabase)            ,out_name        = os.path.basename(aprx.defaultGeodatabase)         );               fac = datasource('facilities');      if arcpy.Exists(fac):         arcpy.Delete_management(fac);      rel = datasource('releases');      if arcpy.Exists(rel):         arcpy.Delete_management(rel);      fbc = datasource('facilities_by_county');      if arcpy.Exists(fbc):         arcpy.Delete_management(fbc);      rbc = datasource('releases_by_county');      if arcpy.Exists(rbc):         arcpy.Delete_management(rbc);      ust = datasource('usts');      if arcpy.Exists(ust):         arcpy.Delete_management(ust);            #########################################################################      purge_domains(aprx.defaultGeodatabase);      build_domains(aprx.defaultGeodatabase);            #########################################################################      build_feature_class(aprx.defaultGeodatabase,'facilities');      build_feature_class(aprx.defaultGeodatabase,'releases');      build_feature_class(aprx.defaultGeodatabase,'facilities_by_county');      build_feature_class(aprx.defaultGeodatabase,'releases_by_county');            build_table(aprx.defaultGeodatabase,'usts');###############################################################################class ReloadFromAGOUST(object):   #...........................................................................   def __init__(self):      self.label              = "A2 Reload From AGO";      self.name               = "ReloadFromAGOUST";      self.description        = "ReloadFromAGOUST";      self.canRunInBackground = False;   #...........................................................................   def getParameterInfo(self):            #########################################################################      param0 = arcpy.Parameter(          displayName   = "Source AGO GUID"         ,name          = "SourceAGOGUID"         ,datatype      = "GPString"         ,parameterType = "Required"         ,direction     = "Input"         ,enabled       = True         ,multiValue    = False      );      param0.value = g_config['maps']['ust_finder_feature_layer']['guid'];            params = [         param0      ];            return params;   #...........................................................................   def isLicensed(self):      return True;   #...........................................................................   def updateParameters(self,parameters):      return;   #...........................................................................   def updateMessages(self,parameters):      return;   #...........................................................................   def execute(self,parameters,messages):      aprx = arcpy.mp.ArcGISProject(g_prj);      arcpy.env.workspace = aprx.defaultGeodatabase;            src_guid = parameters[0].valueAsText;            gis = GIS();      gs = gis.content.get(src_guid);      arcpy.AddMessage("Pulling data from " + str(gs.url));            #########################################################################      fac = datasource('facilities');      if not arcpy.Exists(fac):         raise Exception('facilities not found');      rel = datasource('releases');      if not arcpy.Exists(rel):         raise Exception('releases not found');      fbc = datasource('facilities_by_county');      if not arcpy.Exists(fbc):         raise Exception('facilities by county not found');      rbc = datasource('releases_by_county');      if not arcpy.Exists(rbc):         raise Exception('resources not found');      ust = datasource('usts');      if not arcpy.Exists(ust):         raise Exception('usts not found');            #########################################################################      arcpy.AddMessage("harvesting facilities");      arcpy.management.TruncateTable(in_table = fac);      arcpy.management.Append(          inputs      = gs.url + '/0'         ,target      = fac         ,schema_type = 'NO_TEST'      );            arcpy.AddMessage("harvesting releases");      arcpy.management.TruncateTable(in_table = rel);      arcpy.management.Append(          inputs      = gs.url + '/1'         ,target      = rel         ,schema_type = 'NO_TEST'      );            arcpy.AddMessage("harvesting facilities_by_county");      arcpy.management.TruncateTable(in_table = fbc);      arcpy.management.Append(          inputs      = gs.url + '/2'         ,target      = fbc         ,schema_type = 'NO_TEST'      );            arcpy.AddMessage("harvesting releases_by_county");      arcpy.management.TruncateTable(in_table = rbc);      arcpy.management.Append(          inputs      = gs.url + '/3'         ,target      = rbc         ,schema_type = 'NO_TEST'      );            arcpy.AddMessage("harvesting usts");      arcpy.management.TruncateTable(in_table = ust);      arcpy.management.Append(          inputs      = gs.url + '/4'         ,target      = ust         ,schema_type = 'NO_TEST'      );         ###############################################################################class LoadTribalCSVsAGO(object):   #...........................................................................   def __init__(self):      self.label              = "A3 Load Tribal CSVs";      self.name               = "LoadTribalCSVs";      self.description        = "LoadTribalCSVs";      self.canRunInBackground = False;   #...........................................................................   def getParameterInfo(self):            #########################################################################      param0 = arcpy.Parameter(          displayName   = "Tribal Facilities CSV"         ,name          = "TribalFacilitiesCSV"         ,datatype      = "DEFile"         ,parameterType = "Required"         ,direction     = "Input"         ,enabled       = True         ,multiValue    = False      );            #########################################################################      param1 = arcpy.Parameter(          displayName   = "Tribal Releases CSV"         ,name          = "TribalReleasesCSV"         ,datatype      = "DEFile"         ,parameterType = "Required"         ,direction     = "Input"         ,enabled       = True         ,multiValue    = False      );            #########################################################################      param2 = arcpy.Parameter(          displayName   = "Tribal USTs CSV"         ,name          = "TribalUSTsCSV"         ,datatype      = "DEFile"         ,parameterType = "Required"         ,direction     = "Input"         ,enabled       = True         ,multiValue    = False      );            params = [          param0         ,param1         ,param2      ];            return params;   #...........................................................................   def isLicensed(self):      return True;   #...........................................................................   def updateParameters(self,parameters):      return;   #...........................................................................   def updateMessages(self,parameters):      return;   #...........................................................................   def execute(self,parameters,messages):      aprx = arcpy.mp.ArcGISProject(g_prj);      arcpy.env.workspace = aprx.defaultGeodatabase;            src_fac = parameters[0].valueAsText;      src_rel = parameters[1].valueAsText;      src_ust = parameters[2].valueAsText;            #########################################################################      with open(src_fac,'r') as file:         reader = csv.DictReader(file);         headers = reader.fieldnames;               for item in headers:         arcpy.AddMessage(item)         ###############################################################################class RebuildMapsUST(object):   #...........................................................................   def __init__(self):      self.label              = "A4 Rebuild Maps UST";      self.name               = "RebuildMapsUST";      self.description        = "RebuildMapsUST";      self.canRunInBackground = False;   #...........................................................................   def getParameterInfo(self):            params = [];            return params;   #...........................................................................   def isLicensed(self):      return True;   #...........................................................................   def updateParameters(self,parameters):      return;   #...........................................................................   def updateMessages(self,parameters):      return;   #...........................................................................   def execute(self,parameters,messages):      aprx = arcpy.mp.ArcGISProject(g_prj);            #########################################################################      fac = datasource('facilities');      if not arcpy.Exists(fac):         raise Exception('facilities not found');      rel = datasource('releases');      if not arcpy.Exists(rel):         raise Exception('releases not found');      fbc = datasource('facilities_by_county');      if not arcpy.Exists(fbc):         raise Exception('facilities by county not found');      rbc = datasource('releases_by_county');      if not arcpy.Exists(rbc):         raise Exception('resources not found');      ust = datasource('usts');      if not arcpy.Exists(ust):         raise Exception('usts not found');            #########################################################################      #########################################################################      mapobj = build_map(          mapid = 'ust_finder_feature_layer'         ,aprx  = aprx      );            z1 = add_layer(          mapobj  = mapobj         ,layerid = 'facilities'      );            z1 = add_layer(          mapobj  = mapobj         ,layerid = 'releases'      );            z1 = add_layer(          mapobj  = mapobj         ,layerid = 'facilities_by_county'      );            z1 = add_layer(          mapobj  = mapobj         ,layerid = 'releases_by_county'      );            z1 = add_table(          mapobj  = mapobj         ,tableid = 'usts'      );            mapobj['map'].defaultCamera.setExtent(g_default_zoom);      mapobj['map'].openView();###############################################################################def get_map(    mapid   ,aprx         = None):   if aprx is None:            if mapid not in g_config['maps']:         raise Exception(mapid + "  not in config");      if 'aprx' not in g_config['maps'][mapid]:         g_config['maps'][mapid]['aprx'] = arcpy.mp.ArcGISProject(g_prj);               else:         if g_config['maps'][mapid]['aprx'] is None:            g_config['maps'][mapid]['aprx'] = arcpy.mp.ArcGISProject(g_prj);            aprx = g_config['maps'][mapid]['aprx'];         else:      g_config['maps'][mapid]['aprx'] = aprx;      ary_maps = aprx.listMaps('*');      if len(ary_maps) > 0:      for item in ary_maps:               if item.name == g_config['maps'][mapid]['mapname']:            g_config['maps'][mapid]['map'] = item;            break;      return g_config['maps'][mapid];      ###############################################################################def build_map(    mapid   ,aprx                 = None):   if aprx is None:      aprx = arcpy.mp.ArcGISProject(g_prj);   #########################################################################   mapobj = get_map(       mapid = mapid      ,aprx  = None   );      in_mapname = mapobj['mapname'];   if 'mapx' not in mapobj:      raise Exception("mapx not found in config");         if mapobj['mapx'] is None or mapobj['mapx'] == "":      raise Exception("mapx file not found " + str(mapobj['mapx']));         in_mapx = os.path.join(aprx.homeFolder,mapobj['mapx']);      if not arcpy.Exists(in_mapx):      raise Exception("mapx not found " + in_mapx);      md_title = None;   md_summary = None;   md_description = None;   md_credits = None;   md_tags = None;   md_accessConstraints = None;      if 'title' in mapobj:       md_title = mapobj['title'];   if 'summary' in mapobj:      md_summary = mapobj['summary'];   if 'description' in mapobj:      md_description = mapobj['description'];   if 'credits' in mapobj:      md_credits = mapobj['credits'];   if 'tags' in mapobj:      md_tags = mapobj['credits'];   if 'accessConstraints' in mapobj:      md_accessConstraints = mapobj['accessConstraints'];     #########################################################################   ary_maps = aprx.listMaps('*');      if len(ary_maps) > 0:            boo_hit = False;      for item in ary_maps:                  for suf in ['1','2','3','4','5','6','7','8','9']:            if item.name == in_mapname + suf:               arcpy.AddMessage("removing existing " + item.name);               aprx.deleteItem(item);                        if item.name == in_mapname:            aprx.deleteItem(item);            break;               #########################################################################   mapx = tempMapx(       in_mapxfile    = in_mapx      ,name           = in_mapname      ,aprx           = aprx   );   map = aprx.importDocument(mapx);   md = map.metadata;      if md_title is not None:      md.title = md_title;         if md_summary is not None:      md.summary = md_summary;         if md_description is not None:      md.description = md_description;         if md_credits is not None:      md.credits = md_credits;         if md_tags is not None:      md.tags = md_tags;      if md_accessConstraints is not None:      md.accessConstraints = md_accessConstraints;      md.save();      mapobj['map'] = map;      return mapobj;   ###############################################################################def tempMapx(    in_mapxfile   ,name           = None   ,aprx           = None):   if aprx is None:      aprx = arcpy.mp.ArcGISProject(g_prj);   with open(in_mapxfile,"r") as jsonFile_target:      data_in = json.load(jsonFile_target);   if 'mapDefinition' in data_in:         if name is not None:         data_in['mapDefinition']['name'] = name;         mapx_target = os.path.join(arcpy.env.scratchFolder,name + '.mapx');   with open(mapx_target,"w") as jsonFile:      json.dump(data_in,jsonFile);   return mapx_target;   ###############################################################################def tempLyrx(    in_layerfile   ,dataset   ,searchName   ,name             = None   ,description      = None   ,popupInfoTitle   = None   ,visibility       = None   ,serviceLayerID   = None   ,cim_fields       = None   ,workspaceFactory = None   ,timeEnabled      = None   ,aprx             = None):   if aprx is None:      aprx = arcpy.mp.ArcGISProject(g_prj);   with open(in_layerfile,"r") as jsonFile_target:      data_in = json.load(jsonFile_target);   if 'layerDefinitions' in data_in:            for item in data_in["layerDefinitions"]:                  if item["name"] == searchName:            item["featureTable"]["dataConnection"]["workspaceConnectionString"] = "DATABASE=" + aprx.defaultGeodatabase;            item["featureTable"]["dataConnection"]["dataset"] = dataset;                        if workspaceFactory is not None:               item["featureTable"]["dataConnection"]["workspaceFactory"] = workspaceFactory;                        if name is not None:               item["name"] = name;                           if description is not None:               item["description"] = description;                           if popupInfoTitle is not None and "popupInfo" in item:               item["popupInfo"]["Title"] = popupInfoTitle;                           if visibility is not None:               item["visibility"] = visibility;                           if serviceLayerID is not None:               item["serviceLayerID"] = serviceLayerID;                           if cim_fields is not None and "featureTable" in item:               if "fieldDescriptions" in item["featureTable"]:                                    has_shape = False;                  has_glbid = False;                  for fld in item["featureTable"]["fieldDescriptions"]:                                          if fld["fieldName"].lower() == 'shape':                        has_shape = True;                                             if fld["fieldName"].lower() == 'globalid':                        has_glbid = True;                                    item["featureTable"]["fieldDescriptions"] = [                      {                         "type" : "CIMFieldDescription"                        ,"alias" : "ObjectID"                        ,"fieldName" : "objectid"                        ,"numberFormat" : {                            "type" : "CIMNumericFormat"                           ,"alignmentOption" : "esriAlignRight"                           ,"alignmentWidth" : 0                           ,"roundingOption" : "esriRoundNumberOfDecimals"                           ,"roundingValue" : 0                         }                        ,"readOnly" : True                        ,"visible" : True                        ,"searchMode" : "Exact"                      }                  ];                                    if has_shape:                     item["featureTable"]["fieldDescriptions"].append(                         {                            "type" : "CIMFieldDescription"                           ,"alias" : "Shape"                           ,"fieldName" : "shape"                           ,"visible" : True                           ,"searchMode" : "Exact"                         }                     );                                    for fd in cim_fields:                      item["featureTable"]["fieldDescriptions"].append(fd);                                          if has_glbid:                     item["featureTable"]["fieldDescriptions"].append(                         {                            "type" : "CIMFieldDescription"                           ,"alias" : "GlobalID"                           ,"fieldName" : "globalid"                           ,"visible" : True                           ,"searchMode" : "Exact"                         }                     );                             if timeEnabled is not None:               item["featureTable"]["timeFields"]["type"] = "CIMTimeTableDefinition";                              if 'startTimeField' in timeEnabled:                  item["featureTable"]["timeFields"]["startTimeField"] = timeEnabled['startTimeField'];                              if 'endTimeField' in timeEnabled:                  item["featureTable"]["timeFields"]["endTimeField"] = timeEnabled['endTimeField'];      if 'tableDefinitions' in data_in:            for item in data_in["tableDefinitions"]:               if item["name"] == searchName:             item["dataConnection"]["workspaceConnectionString"] = "DATABASE=" + aprx.defaultGeodatabase;            item["dataConnection"]["dataset"] = dataset;                        if workspaceFactory is not None:               item["dataConnection"]["workspaceFactory"] = workspaceFactory;            if name is not None:               item["name"] = name;                           if description is not None:               item["description"] = description;                           if serviceLayerID is not None:               item["serviceTableID"] = serviceLayerID;      lyrx_target = os.path.join(arcpy.env.scratchFolder,dataset + '.lyrx');   with open(lyrx_target,"w") as jsonFile:      json.dump(data_in,jsonFile);   return lyrx_target;         ###############################################################################def add_lyr_base(    in_map   ,in_lyrx   ,in_dataset   ,in_searchName    ,in_name   ,in_description    = None   ,in_popupInfoTitle = None   ,symbology_fields  = None   ,update_symbology  = None   ,in_visibility     = None   ,serviceLayerID    = None   ,cim_fields        = None   ,timeEnabled       = None   ,aprx              = None):      lyrx = tempLyrx(       in_layerfile     = in_lyrx      ,dataset          = os.path.basename(in_dataset)      ,searchName       = in_searchName      ,name             = in_name      ,description      = in_description      ,popupInfoTitle   = in_popupInfoTitle      ,visibility       = in_visibility      ,serviceLayerID   = serviceLayerID      ,cim_fields       = cim_fields      ,timeEnabled      = timeEnabled      ,aprx             = aprx   );      lyr = arcpy.mp.LayerFile(lyrx);   z = in_map.addLayer(lyr,'BOTTOM');      ############################################################################   if symbology_fields is not None:       lyr = in_map.listLayers('*')[0];      z = arcpy.management.ApplySymbologyFromLayer(          in_layer           = lyr         ,in_symbology_layer = lyrx         ,symbology_fields   = symbology_fields         ,update_symbology   = update_symbology      );           return lyr;###############################################################################def add_tbl_base(    in_map   ,in_lyrx   ,in_dataset   ,in_searchName    ,in_name   ,in_description    = None   ,serviceTableID    = None   ,aprx              = None):      tblx = tempLyrx(       in_layerfile     = in_lyrx      ,dataset          = os.path.basename(in_dataset)      ,searchName       = in_searchName      ,name             = in_name      ,description      = in_description      ,popupInfoTitle   = None      ,visibility       = None      ,serviceLayerID   = serviceTableID      ,cim_fields       = None      ,timeEnabled      = None      ,aprx             = aprx   );      tbl = arcpy.mp.LayerFile(tblx);   tbl = in_map.addLayer(tbl);      return tbl;   ###############################################################################def add_layer(    mapobj   ,layerid   ,aprx  = None):   if 'aprx' not in mapobj:      if aprx is None:         aprx = arcpy.mp.ArcGISProject(g_prj);      else:         mapobj['aprx'] = aprx;   if mapobj['aprx'] is None:      if aprx is None:         aprx = arcpy.mp.ArcGISProject(g_prj);      else:         mapobj['aprx'] = aprx;         aprx = mapobj['aprx'];      if layerid not in mapobj['layers']:      raise Exception("layerid not found in config " + str(layerid) + " " + str(mapobj['layers']));      lyrobj = mapobj['layers'][layerid];   if 'lyrx' not in lyrobj:      raise Exception("lyrx for layer not found in config");         lyrx   = os.path.join(aprx.homeFolder,lyrobj['lyrx']);   if not arcpy.Exists(lyrx):      raise Exception("lyrx file not found " + str(lyrx));         if 'schema' not in mapobj['layers'][layerid]:      raise Exception('schema value not found in map layer config');      sch_name = mapobj['layers'][layerid]['schema'];   if sch_name not in g_config['schemas']:      raise Exception('schema ' + str(sch_name) + ' not found in config');         sch = g_config['schemas'][sch_name];      val_description = None;   val_popupInfoTitle = None;   val_symbology_fields = None;   val_update_symbology = None;   val_visibility = None;   val_serviceLayerID = None;   val_cim_fields = None;   val_timeEnabled = None;      if 'description' in lyrobj:      val_description = lyrobj['description'];   if 'popupInfoTitle' in lyrobj:      val_popupInfoTitle = lyrobj['popupInfoTitle'];   if 'symbology_fields' in lyrobj:      val_symbology_fields = lyrobj['symbology_fields'];   if 'update_symbology' in lyrobj:      val_update_symbology = lyrobj['update_symbology'];   if 'visibility' in lyrobj:      val_visibility = lyrobj['visibility'];   if 'serviceLayerID' in lyrobj:      val_serviceLayerID = lyrobj['serviceLayerID'];   if 'cim_fields' in lyrobj:      val_cim_fields = lyrobj['cim_fields'];   if 'timeEnabled' in lyrobj:      val_timeEnabled = lyrobj['timeEnabled'];      lyr = add_lyr_base(       in_map            = mapobj['map']      ,in_lyrx           = lyrx      ,in_dataset        = datasource(sch_name)      ,in_searchName     = lyrobj['searchName']      ,in_name           = lyrobj['name']      ,in_description    = val_description      ,in_popupInfoTitle = val_popupInfoTitle      ,symbology_fields  = val_symbology_fields      ,update_symbology  = val_update_symbology      ,in_visibility     = val_visibility      ,serviceLayerID    = val_serviceLayerID      ,cim_fields        = val_cim_fields      ,timeEnabled       = val_timeEnabled      ,aprx              = aprx   );      return lyr;###############################################################################def add_table(    mapobj   ,tableid   ,aprx  = None):   if 'aprx' not in mapobj:      if aprx is None:         aprx = arcpy.mp.ArcGISProject(g_prj);      else:         mapobj['aprx'] = aprx;   if mapobj['aprx'] is None:      if aprx is None:         aprx = arcpy.mp.ArcGISProject(g_prj);      else:         mapobj['aprx'] = aprx;         aprx = mapobj['aprx'];      if tableid not in mapobj['tables']:      raise Exception("tableid not found in config " + str(tableid) + " " + str(mapobj['tables']));      tblobj = mapobj['tables'][tableid];   if 'lyrx' not in tblobj:      raise Exception("lyrx for table not found in config");      lyrx   = os.path.join(aprx.homeFolder,tblobj['lyrx']);   if not arcpy.Exists(lyrx):      raise Exception("lyrx file not found " + str(lyrx));         if 'schema' not in mapobj['tables'][tableid]:      raise Exception('schema value not found in map table config');      sch_name = mapobj['tables'][tableid]['schema'];   if sch_name not in g_config['schemas']:      raise Exception('schema ' + str(sch_name) + ' not found in config');         sch = g_config['schemas'][sch_name];      val_description = None;     if 'description' in tblobj:      val_description = tblobj['description'];         val_serviceTableID = None;   if 'serviceTableID' in tblobj:      val_serviceTableID = tblobj['serviceTableID'];         tbl = add_tbl_base(       in_map            = mapobj['map']      ,in_lyrx           = lyrx      ,in_dataset        = datasource(sch_name)      ,in_searchName     = tblobj['searchName']      ,in_name           = tblobj['name']      ,in_description    = val_description      ,serviceTableID    = val_serviceTableID      ,aprx              = aprx   );      return tbl;           ###############################################################################def purge_domains(target_ws):   desc = arcpy.Describe(target_ws);      for domain in desc.Domains:      arcpy.management.DeleteDomain(target_ws,domain);            return 0;###############################################################################def domain_exists(target_ws,domain_name):   desc = arcpy.Describe(target_ws);      for domain in desc.Domains:      if domain == domain_name:         return True;            return False;   ###############################################################################def build_domains(target_ws,domain_name = None):           if len(g_config['domains']) > 0:               if domain_name is None:         keys = [key for key in g_config['domains']];      else:         if domain_name not in g_config['domains']:            raise Exception("domain missing from config");                        else:            keys = list(domain_name);                     for item in keys:         dm = g_config['domains'][item];                  arcpy.management.CreateDomain(             in_workspace       = target_ws            ,domain_name        = dm["name"]            ,domain_description = dm["description"]            ,field_type         = dm["field_type"]            ,domain_type        = dm["domain_type"]            ,split_policy       = dm["split_policy"]            ,merge_policy       = dm["merge_policy"]         );                  if dm["domain_type"] == "CODED":                        for vals in dm["coded_values"]:                              arcpy.management.AddCodedValueToDomain(                   in_workspace       = target_ws                  ,domain_name        = dm["name"]                  ,code               = vals[0]                  ,code_description   = vals[1]               );      ###############################################################################def build_feature_class(target_ws,fc_name):   if fc_name not in g_config['schemas']:      raise Exception("schema missing from config")         fc = datasource(fc_name);   ob = g_config['schemas'][fc_name];      if arcpy.Exists(fc):      raise Exception("preexisting " + fc_name + " found");   arcpy.CreateFeatureclass_management(       out_path          = os.path.dirname(fc)      ,out_name          = os.path.basename(fc)      ,geometry_type     = ob["geometry_type"]      ,has_m             = ob["has_m"]      ,has_z             = ob["has_z"]      ,spatial_reference = arcpy.SpatialReference(ob["srid"])      ,oid_type          = ob["oid_type"]   );   arcpy.management.AddFields(       in_table          = fc      ,field_description = fld_def(fc_name)   );         for item in fld_idx(fc_name):      arcpy.management.AddIndex(          in_table   = fc         ,fields     = [item]         ,index_name = item + '_idx'      );         arcpy.management.AddGlobalIDs(      in_datasets  = fc   );   ###############################################################################def build_table(target_ws,tb_name):   if tb_name not in g_config['schemas']:      raise Exception("schema missing from config")         tb = datasource(tb_name);   ob = g_config['schemas'][tb_name];      if arcpy.Exists(tb):      raise Exception("preexisting " + tb_name + " found");   arcpy.CreateTable_management(       out_path          = os.path.dirname(tb)      ,out_name          = os.path.basename(tb)      ,oid_type          = ob["oid_type"]   );   arcpy.management.AddFields(       in_table          = tb      ,field_description = fld_def(tb_name)   );         for item in fld_idx(tb_name):      arcpy.management.AddIndex(          in_table   = tb         ,fields     = [item]         ,index_name = item + '_idx'      );         arcpy.management.AddGlobalIDs(      in_datasets  = tb   );   